#     for file in $SECRETS; do
#         if grep -E "(api[_-]?key|apikey|password)\s*[:=]\s*['\"][^'\"]{10,}" "$file" 2>/dev/null | grep -v "// \|/\*\|shareToken\|tokenExpiry" | head -1 | grep -q .; then
#             echo -e "${RED}❌ Error: Potential secrets found in $file${NC}"
#             echo "Remove sensitive data before committing"
#             exit 1
#         fi
#     done
# fi

# 6. Check for large files (>1MB)
LARGE_FILES=$(git diff --cached --name-only | while read file; do
    if [ -f "$file" ]; then
        SIZE=$(wc -c < "$file")
        if [ $SIZE -gt 1048576 ]; then
            echo "$file ($(($SIZE / 1048576))MB)"
        fi
    fi
done)
if [ ! -z "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠️  Warning: Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo "Consider using Git LFS for large files"
    WARNINGS=$((WARNINGS + 1))
fi

# 7. Run ESLint with strict settings (no auto-fix in pre-commit)
# Docker-first project - skip if dependencies are broken
if command -v npx >/dev/null 2>&1 && [ -f "package.json" ] && [ -d "node_modules/eslint" ]; then
    echo "⏳ Running ESLint (strict mode)..."
    if ! npx eslint . --max-warnings 0 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Warning: ESLint check skipped (broken dependencies - Docker-first project)${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo "⏭️  Skipping ESLint (missing dependencies - Docker-first project)"
fi

# 7b. Backend ESLint (baseline gate)
#
# The ESLint step above runs the ROOT eslint.config.js, which explicitly
# ignores `backend/**`. Nothing else covered that tree either, so a hard
# ESLint error in backend/src passed a fully green `make ci` on 2026-08-28.
#
# scripts/eslint-baseline.mjs lints backend/src for real and compares the
# result against the committed eslint-baseline.json: pre-existing problems do
# not block commits, anything NEW does. Accepting a new one is a deliberate,
# reviewable act — `npm run lint:backend:update` rewrites the committed
# baseline, so it shows up as added lines in the diff.
if command -v node >/dev/null 2>&1 && [ -d "backend/node_modules/eslint" ]; then
    echo "⏳ Running backend ESLint (baseline gate)..."
    set +e  # Temporarily disable exit on error
    node scripts/eslint-baseline.mjs
    BACKEND_LINT_EXIT=$?
    set -e  # Re-enable exit on error
    if [ $BACKEND_LINT_EXIT -eq 1 ]; then
        echo -e "${RED}❌ Error: new backend ESLint problems introduced (see above)${NC}"
        echo -e "${YELLOW}💡 Fix them, or — if deliberate — run 'npm run lint:backend:update'${NC}"
        exit 1
    elif [ $BACKEND_LINT_EXIT -ne 0 ]; then
        # Exit 2 = the gate itself could not run. Fail closed: a check that
        # cannot run must never be reported as a check that passed.
        echo -e "${RED}❌ Error: the backend ESLint gate could not run (exit $BACKEND_LINT_EXIT)${NC}"
        exit 1
    fi
else
    echo -e "${YELLOW}⚠️  Warning: Skipping backend ESLint gate (backend/node_modules not installed)${NC}"
    WARNINGS=$((WARNINGS + 1))
fi

if command -v npx >/dev/null 2>&1 && [ -f "package.json" ] && [ -d "node_modules/prettier" ]; then
    echo "⏳ Checking code formatting..."
    if ! npx prettier --check .; then
        echo -e "${RED}❌ Error: Code formatting issues found${NC}"
        echo -e "${YELLOW}💡 Run 'npm run format' to fix formatting${NC}"
        exit 1
    fi
else
    echo "⏭️  Skipping Prettier (missing dependencies - Docker-first project)"
fi

# 8. Check TypeScript (both frontend and backend)
#
# The frontend check runs `npm run type-check`, which is
# scripts/type-check-baseline.mjs: it type-checks tsconfig.app.json,
# tsconfig.node.json and tsconfig.test.json for real and fails on any error
# that is not already in the committed typecheck-baseline.json.
#
# It replaces a bare `tsc --noEmit` on the root tsconfig, which was a
# SOLUTION-style config ("files": [] + "references"). `tsc -p` does not follow
# project references, so that command compiled ZERO files and exited 0 for
# every commit this hook has ever "checked". Do not put it back.
#
# This is a FULL-PROJECT check on every commit, not a staged-files-only check,
# because a staged-files-only TypeScript check is unsound: editing a type in a
# staged file breaks unstaged files that consume it. Measured cost on this
# repo: a few seconds warm (tsc incremental via *.tsbuildinfo).
if [ -f "tsconfig.json" ]; then
    echo "⏳ Checking frontend TypeScript (baseline gate)..."
    if docker compose ps frontend 2>/dev/null | grep -q "Up"; then
        if ! docker compose exec -T frontend npm run type-check; then
            echo -e "${RED}❌ Error: Frontend TypeScript check failed${NC}"
            exit 1
        fi
    elif command -v node >/dev/null 2>&1 && [ -d "node_modules/typescript" ]; then
        set +e  # Temporarily disable exit on error
        npm run --silent type-check
        TS_EXIT=$?
        set -e  # Re-enable exit on error
        if [ $TS_EXIT -eq 1 ]; then
            echo -e "${RED}❌ Error: new TypeScript errors introduced (see above)${NC}"
            echo -e "${YELLOW}💡 Fix them, or — if deliberate — run 'npm run type-check:update'${NC}"
            exit 1
        elif [ $TS_EXIT -ne 0 ]; then
            # Exit 2 = the gate itself could not run. Fail closed: a check that
            # cannot run must never be reported as a check that passed.
            echo -e "${RED}❌ Error: the TypeScript gate could not run (exit $TS_EXIT)${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}⚠️  Warning: Skipping frontend TypeScript check (typescript not installed and Docker not running)${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

if [ -f "backend/tsconfig.json" ]; then
    echo "⏳ Checking backend TypeScript..."
    if docker compose ps backend 2>/dev/null | grep -q "Up"; then
        if ! docker compose exec -T backend npx tsc --noEmit; then
            echo -e "${RED}❌ Error: Backend TypeScript compilation failed${NC}"
            exit 1
        fi
    elif command -v npx >/dev/null 2>&1 && [ -w "backend/node_modules" ] 2>/dev/null; then
        cd backend
        set +e  # Temporarily disable exit on error
        TS_OUTPUT=$(npx tsc --noEmit 2>&1)
        TS_EXIT=$?
        set -e  # Re-enable exit on error
        cd ..
        if [ $TS_EXIT -ne 0 ]; then
            # Check if errors are environment-related (missing dependencies) vs code issues
            set +e
            echo "$TS_OUTPUT" | grep -q "Cannot find module"
            HAS_MODULE_ERROR=$?
            set -e
            if [ $HAS_MODULE_ERROR -eq 0 ]; then
                echo -e "${YELLOW}⚠️  Warning: Skipping backend TypeScript check (environment setup issue - dependencies not resolved)${NC}"
                echo -e "${YELLOW}💡 Run checks in Docker: 'make type-check'${NC}"
                WARNINGS=$((WARNINGS + 1))
            else
                echo -e "${RED}❌ Error: Backend TypeScript compilation failed${NC}"
                echo "$TS_OUTPUT"
                exit 1
            fi
        fi
    else
        echo -e "${YELLOW}⚠️  Warning: Skipping backend TypeScript check (Docker not running)${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# 9. Check Python files (if changed)
PYTHON_FILES=$(git diff --cached --name-only | grep -E "\.py$" || true)
if [ ! -z "$PYTHON_FILES" ]; then
    if command -v ruff >/dev/null 2>&1; then
        echo "⏳ Checking Python code with ruff..."
        if ! ruff check $PYTHON_FILES; then
            echo -e "${YELLOW}⚠️  Warning: Python linting issues found${NC}"
            WARNINGS=$((WARNINGS + 1))
        fi
    elif command -v flake8 >/dev/null 2>&1; then
        echo "⏳ Checking Python code with flake8..."
        if ! flake8 $PYTHON_FILES; then
            echo -e "${YELLOW}⚠️  Warning: Python linting issues found${NC}"
            WARNINGS=$((WARNINGS + 1))
        fi
    fi
fi

# 10. Run lint-staged for additional checks
if [ -f ".lintstagedrc.json" ]; then
    echo "⏳ Running lint-staged..."
    if command -v npx >/dev/null 2>&1 && [ -w "node_modules" ] 2>/dev/null; then
        # Check if lint-staged is available
        set +e
        npx --no-install lint-staged --version >/dev/null 2>&1
        LINT_STAGED_EXISTS=$?
        set -e
        if [ $LINT_STAGED_EXISTS -ne 0 ]; then
            echo -e "${YELLOW}⚠️  Warning: Skipping lint-staged (not installed in node_modules)${NC}"
            WARNINGS=$((WARNINGS + 1))
        else
            set +e
            npx lint-staged
            LINT_STAGED_EXIT=$?
            set -e
            if [ $LINT_STAGED_EXIT -ne 0 ]; then
                echo -e "${RED}❌ Error: lint-staged checks failed${NC}"
                exit 1
            fi
        fi
    else
        echo -e "${YELLOW}⚠️  Warning: Skipping lint-staged (npm not available)${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo "⏭️  Skipping lint-staged (missing dependencies - Docker-first project)"
fi

# 11. Check commit message format (if commit message is available)
if [ -f ".gitmessage" ]; then
    # This would be checked in commit-msg hook instead
    true
fi

# Summary
if [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}✓ Pre-commit checks passed with $WARNINGS warning(s)${NC}"
else
    echo -e "${GREEN}✅ All pre-commit checks passed successfully!${NC}"
fi

exit 0