{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "composite": true,

    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node",
      "vite/client"
    ],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "noImplicitAny": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["backend/src/services/export/imagejColor.ts"],
  // ALL of src, not just the tests. `composite` (required: tsconfig.json
  // references this project) demands that every file in the program be matched
  // here, and tsc puts every file a test IMPORTS into the program and checks
  // it. With a tests-only include each imported source raised TS6307 instead —
  // 350 of the 1215 errors this project reported, all of them baselined, so a
  // file-list mismatch hid behind the gate. Measured 2026-09-13: this include
  // removes all 350 and adds 6, from files no test imports and tsc therefore
  // never checked (src/test/setup.ts, src/test-utils/mockComponents.tsx); a
  // 7th, in src/main.tsx, is excluded below. Sources stay on the
  // stricter app project in the editor, which the solution config lists first.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "tests/**/*",
    "vitest.setup.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  // main.tsx is the browser entry: no test imports it, and it imports App with
  // a `.tsx` extension that only the app project permits.
  "exclude": ["node_modules", "dist", "backend", "coverage", "src/main.tsx"]
}
