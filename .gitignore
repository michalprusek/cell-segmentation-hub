screenshots/
videos/
backups/
.backups/
.tmp_viz/
.playwright-mcp/
scripts/certbot-logs/
certbot/

# Local-only env (Grafana admin password)
.env.monitoring

# External / scratch model artifacts dropped at repo root. These are training
# and validation packages staged by hand on the box (3.5 GB combined), not
# repository content. Each currently carries its own nested `.gitignore` holding
# a single `*`, but that file is itself untracked host state: delete it, or
# re-stage the directory from a copy that never had one, and the next
# `git add -A` starts committing gigabytes. The rules below live in the repo, so
# the protection travels with a clone.
#
# `mt-instance-seg-v5H/` in particular is load-bearing on this host: it is the
# default source for scripts/download-microtubule-weights.sh. Ignore it; do not
# delete it.
path_c_v24c/
mt34-benchmark/
mt-instance-seg/
mt-instance-seg-v5H/
neurite-soma-seg/

# HuggingFace model cache (transformers + DINOv3 backbone downloads)
backend/segmentation/.hf-cache/

# TypeScript incremental build cache
*.tsbuildinfo

# The FRAP endpoint's API key lives in this nginx snippet on the server and must
# never be committed. The rule was applied by hand on cvat2 during deployment and
# survived only as an uncommitted local edit -- one `git checkout` from being
# lost, after which the next `git add -A` there would publish the key.
docker/nginx/snippets/frap-key.conf

# Local Python virtualenvs. `backend/segmentation` needs one to run its pytest
# suite, and without this rule the whole tree lands in `git status` and in
# prettier's --check (which the pre-commit hook runs over the repo), so the hook
# fails on vendored files nobody wrote.
.venv*/
venv/
**/.venv*/
