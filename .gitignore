.eslintcache

# Serena MCP tool state. The whole directory is local editor/agent config, not
# project source — `project.yml` and the nested `/cache` ignore were tracked by
# accident. (`.serena/memories/` alone used to be listed here, which left the
# config file itself committable.)
.serena/

# Report emitted by scripts/code-quality-check.js, which .lintstagedrc.json runs
# on every commit — so without this rule the artifact lands in `git status`
# after any staged change.
code-quality-report.json

