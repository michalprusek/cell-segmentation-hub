# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-journal
# NOTE: prisma/migrations/ must NOT be ignored. Production applies migrations
# with `prisma migrate deploy`, which can only replay migration files that are
# committed. All 9 existing migrations are tracked (they were added past this
# rule), but a NEW one created by `prisma migrate dev` would be silently skipped
# by `git add`, ship a schema-less deploy, and only surface as a runtime error
# against production. So there is deliberately no pattern for them here.

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Uploads and temp files
uploads/
temp/
*.tmp

