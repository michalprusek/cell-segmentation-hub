# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-journal
# NOTE: prisma/migrations/ must NOT be ignored. Production applies migrations
# with `prisma migrate deploy`, which can only replay migration files that are
# committed. A migration created by `prisma migrate dev` while a pattern existed
# here was silently skipped by `git add`, so it shipped a schema-less deploy and
# surfaced only as a runtime error against production. That is exactly how nine
# migrations — including 0001_init, the whole base schema — sat untracked while
# this comment claimed they were all committed. There is deliberately no pattern
# for them here; check `git status backend/prisma/migrations` after generating one.

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Dependency directories
jspm_packages/

