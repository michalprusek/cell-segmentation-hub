{
  "name": "cell-segmentation-backend",
  "version": "1.0.0",
  "description": "Backend API for cell segmentation platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit --skipLibCheck",
    "list-endpoints": "tsx -e \"import { routeRegistry } from './src/api/routes'; console.log('Registered API Endpoints:'); routeRegistry.forEach(r => console.log('  ' + r.method.padEnd(6) + ' ' + r.path + ' - ' + (r.description || 'No description')));\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test-api": "echo 'Testing API endpoints...' && curl -s http://localhost:3001/health | jq '.' && curl -s http://localhost:3001/api/endpoints | jq '.data.count' && curl -s http://localhost:3001/metrics | head -5",
    "docker:build": "docker build -f ../docker/backend.Dockerfile -t spheroseg-backend .",
    "docker:run": "docker run -p 3001:3001 --env-file .env spheroseg-backend"
  },
  "keywords": [
    "cell-segmentation",
    "api",
    "backend"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "archiver": "^6.0.2",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^2.11.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.0",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "validator": "^13.15.35",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/form-data": "^2.5.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "tar": "^7.5.21",
    "brace-expansion": "^2.1.4",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "socket.io-parser": "^4.2.7",
    "body-parser": "^1.20.6",
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "uuid": "$uuid"
  }
}
